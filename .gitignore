# ---------------------------------------------------------------- secrets: never commit
.env
.env.*
!.env.example
keys/
*.p8
*.pem

# ---------------------------------------------------------------- data: never commit
# Freddie Mac's terms forbid redistributing loan rows, so no data file of any kind goes in git.
# All local data lives under data/ (raw downloads, DuckDB files, exports).
data/
*.parquet
*.duckdb
*.duckdb.wal
*.zip
# Freddie's files are .txt (pipe-delimited) and other sources are .csv: both are ignored
# everywhere, except small synthetic fixtures under a tests/fixtures/ folder.
*.txt
*.csv
!**/tests/fixtures/**/*.txt
!**/tests/fixtures/**/*.csv
# Dependency pins are .txt files too: keep them.
!requirements*.txt
!airflow/requirements.txt

# ---------------------------------------------------------------- private documents
# The roadmap PDFs were prepared for Martins only: they stay on his PC and are never committed.
docs/CECL_Lifetime_Loss_Lab_Roadmap*.pdf

# ---------------------------------------------------------------- python / tools
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------------------------------------------------------------- mlflow (local test stores)
mlruns/
mlartifacts/

# ---------------------------------------------------------------- airflow
logs/
airflow/logs/

# ---------------------------------------------------------------- dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# ---------------------------------------------------------------- databricks
# Bundle cache; the bundle's state lives in the workspace.
.databricks/

# ---------------------------------------------------------------- site
site_build/

# ---------------------------------------------------------------- OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Private working documents (never published)
Claude outputs/

# Website build and test output (site/)
site/node_modules/
site/.astro/
site/test-results/
site/playwright-report/
# The website's data files and schemas are aggregates only (no loan rows; checked in CI), so they are
# kept, as on the Bank Health site. Only these two folders are exempt from the data/ rule above.
!site/public/data/
!site/data/
