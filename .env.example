# Copy to .env (git-ignored) and fill in. Names only here: never put a real value in this file.
# Martins adds the real values himself.

# Which environment this process is: local | ci | dev | prod. Required, no default.
# Airflow stacks set it in their Compose file (dev or prod); scripts read it from here.
CECL_ENV=local

# Local DuckDB file for dbt's `local` target (under data/, which git ignores).
CECL_DUCKDB_PATH=data/local/cecl_lab.duckdb

# Databricks (dbt dev/prod targets, Airflow). Phase 1; leave empty until then.
DATABRICKS_HOST=<your-workspace>
DATABRICKS_HTTP_PATH=<sql-warehouse-http-path>
DATABRICKS_TOKEN=<set-by-martins>

# Alerts (Phase 1). Separate channels for dev and prod: each environment's .env holds its own
# webhooks. Messages are prefixed [CECL] (prod) or [CECL dev] (dev) so they never look like Bank
# Health's.
SLACK_WEBHOOK_URL=<set-by-martins>
DISCORD_WEBHOOK_URL=<set-by-martins>

# Databricks layout: "catalogs" (cecl_lab_dev / cecl_lab) or "schema_prefix" (fallback: one
# catalog, schemas named cecl_lab_dev_* / cecl_lab_*). See cecl/environment.py.
CECL_DATABRICKS_LAYOUT=catalogs
